{
  "include": [
    "docs/企劃案/tools",
    "tools",
    "tests",
    "backend"
  ],
  "exclude": [
    ".venv",
    ".venv-compat",
    ".venv-backend"
  ],
  "venvPath": ".",
  "venv": ".venv-backend",
  "pythonVersion": "3.13",
  "typeCheckingMode": "strict",
  "executionEnvironments": [
    {
      "root": "backend",
      "pythonVersion": "3.13",
      "extraPaths": [
        "backend"
      ]
    },
    {
      "root": "."
    }
  ],
  "reportUnnecessaryTypeIgnoreComment": "error"
}
