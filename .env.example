# Local development only. Copy to .env and replace every placeholder.
AXIOM_SECRET_KEY=
AXIOM_DB_PASSWORD=
AXIOM_JOURNAL_TOKEN=
# Optional: create the local accounts after a rebuilt database; unset means no bootstrap.
# A JSON array of {"user","password"}; every account shares AXIOM_BOOTSTRAP_TENANT,
# so one account for the human and one for the agent see the same data.
AXIOM_BOOTSTRAP_ACCOUNTS=
AXIOM_BOOTSTRAP_TENANT=local
AXIOM_WEB_PORT=18000
AXIOM_FRONTEND_PORT=15173

# 明確啟用 SEARCH 專用服務時，同時將 search 加入 COMPOSE_PROFILES。
AXIOM_SEARCH_ENABLED=0
AXIOM_SEARCH_LIMITS={"max_rows":4096,"max_strategy_seconds":10,"max_candidates":8}
